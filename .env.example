# Copy this file to .env and fill in real values. .env is gitignored.

# Only needed for running the backend directly on the host (outside Docker
# Compose) — docker-compose.yml sets DATABASE_URL/REDIS_URL itself for
# container-to-container networking.
DATABASE_URL=postgresql+asyncpg://strata:strata@localhost:5432/strata_learn
REDIS_URL=redis://localhost:6379/0

# Required in the body of POST /auth/register — closes the fresh-install
# race where anyone reaching the API before the operator registers would
# otherwise permanently own the single account. Change this before any
# deployment reachable by anyone other than you.
REGISTRATION_SECRET=change-me

# Anthropic is the only production provider currently implemented.
ANTHROPIC_API_KEY=
# Reserved for the planned OpenAI provider; currently unused.
OPENAI_API_KEY=
