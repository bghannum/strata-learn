# Copy this file to .env and fill in real values. .env is gitignored.

# Only needed for running the backend directly on the host (outside Docker
# Compose) — docker-compose.yml sets DATABASE_URL/REDIS_URL itself for
# container-to-container networking.
DATABASE_URL=postgresql+asyncpg://strata:strata@localhost:5432/strata_learn
REDIS_URL=redis://localhost:6379/0
# pytest never touches DATABASE_URL's database: it derives `<db>_test` (created and
# migrated automatically) and refuses to run if this points at the same one.
# TEST_DATABASE_URL=postgresql+asyncpg://strata:strata@localhost:5432/strata_learn_test

# Optional. Blank (the default) means the first visitor to a fresh install
# creates the single account with no extra step — on localhost that visitor
# is you. Set a value before exposing the app beyond localhost: the setup
# form then asks for it, which closes the race where anyone reaching the API
# before you would otherwise permanently own the account.
REGISTRATION_SECRET=

# Anthropic is the only production text-LLM provider currently implemented.
ANTHROPIC_API_KEY=
# Used by the Phase 8 voice layer's hosted backends (ADR-010). Not required
# for anything else; leave blank if neither *_BACKEND below is "openai".
OPENAI_API_KEY=

# Phase 8 voice (ADR-010). One switch per capability, independent of each
# other: "local" (in-process, free — the default; the api image ships the
# runtimes and weights download on first use, ~500 MB, into a named volume),
# "openai" (hosted, needs OPENAI_API_KEY), or blank to turn it off. Off just
# means no mic button or read-aloud control; nothing else changes.
TRANSCRIPTION_BACKEND=local
SPEECH_BACKEND=local
# Set to false for a slimmer api image without the local runtimes (then use
# openai above, or leave the switches blank).
INSTALL_VOICE=true
