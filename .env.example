# Copy this file to .env and fill in real values. .env is gitignored.

# Only needed for running the backend directly on the host (outside Docker
# Compose) — docker-compose.yml sets DATABASE_URL/REDIS_URL itself for
# container-to-container networking.
DATABASE_URL=postgresql+asyncpg://strata:strata@localhost:5432/strata_learn
REDIS_URL=redis://localhost:6379/0

# Required in the body of POST /auth/register — closes the fresh-install
# race where anyone reaching the API before the operator registers would
# otherwise permanently own the single account. Change this before any
# deployment reachable by anyone other than you.
REGISTRATION_SECRET=change-me

# Anthropic is the only production text-LLM provider currently implemented.
ANTHROPIC_API_KEY=
# Used by the Phase 8 voice layer's hosted backends (ADR-010). Not required
# for anything else; leave blank if neither *_BACKEND below is "openai".
OPENAI_API_KEY=

# Phase 8 voice (ADR-010). One switch per capability, independent of each
# other: "openai" (hosted, needs OPENAI_API_KEY), "local" (in-process, needs
# the image built with INSTALL_VOICE=true), or blank to turn it off. Off is
# the default — nothing renders a mic button or a read-aloud control, and
# nothing else in the app changes.
TRANSCRIPTION_BACKEND=
SPEECH_BACKEND=
