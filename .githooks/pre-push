#!/usr/bin/env bash
# Advisory local Codex review, run automatically before every push.
#
# Never blocks the push — Codex review is advisory-only by project convention
# (see CLAUDE.md "Git workflow"). A missing `codex` CLI or a failed review just
# skips instead of failing the push. Requires `codex login` once, via ChatGPT
# subscription auth (not an API key) — see developers.openai.com/codex.
#
# Reads pushed refs from stdin (git's pre-push contract: `<local ref> <local
# oid> <remote ref> <remote oid>` per line) instead of assuming the checked-out
# branch is what's being pushed — covers `git push origin other-branch`,
# multi-ref pushes, and detached-HEAD pushes correctly.
set -uo pipefail

repo_root=$(git rev-parse --show-toplevel)
output_file="$repo_root/CODEX_CODE_REVIEW.md"
rm -f "$output_file"

if ! command -v codex >/dev/null 2>&1; then
  echo "pre-push: codex CLI not found, skipping local review (see developers.openai.com/codex)" >&2
  exit 0
fi

zero_oid="0000000000000000000000000000000000000000"
head_oid=$(git rev-parse HEAD)

while read -r local_ref local_oid _remote_ref _remote_oid; do
  [ "$local_oid" = "$zero_oid" ] && continue  # deleting a remote ref
  branch="${local_ref#refs/heads/}"
  [ "$branch" = "main" ] && continue

  if [ "$local_oid" != "$head_oid" ]; then
    echo "pre-push: skipping Codex review for $branch — not the checked-out HEAD, can't safely diff it" >&2
    continue
  fi

  echo "pre-push: running local Codex review of $branch against main..." >&2
  if codex exec review --base main --title "$branch" --output-last-message "$output_file"; then
    echo "pre-push: review written to CODEX_CODE_REVIEW.md — read it before opening/updating the PR." >&2
  else
    echo "pre-push: Codex review failed for $branch, skipping (push continues)" >&2
    rm -f "$output_file"
  fi
done

exit 0
